# Copy to .env next to compose.yaml. .env is gitignored.

# Absolute path on the host to the folder holding your GGUF files, and the file
# to serve from it.
MODELS_DIR=/home/you/llm/models
LLAMA_MODEL_FILE=Qwen3-14B-Q4_K_M.gguf

# Model id shown in the status pill.
#LLAMA_ALIAS=qwen3-14b

# Context length. Larger costs VRAM on top of the weights: a 14B model at Q4
# plus 8k of context fits a 12 GB card.
#LLAMA_CTX=8192

# 0 disables thinking, as the desktop sidecar does. -1 lets the model think.
#LLAMA_REASONING_BUDGET=0

# llama.cpp's CUDA server image. Swap it for one built for your GPU if the
# official image does not run on it.
#LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda

# Host port for the server.
#PENUMBRA_PORT=3000

# Optional shared secret for /agent, /lab, and /compute. Prefer per-device
# tokens: add the first device from inside the container, where the request is
# loopback:
#   docker compose exec server node -e "fetch('http://127.0.0.1:3000/auth/devices',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({label:'laptop'})}).then(r=>r.text()).then(console.log)"
#PENUMBRA_AGENT_TOKEN=

# Extra browser origins, comma-separated. Only needed for the web build served
# from somewhere other than the built-in origins; the desktop app is built in.
#PENUMBRA_ALLOWED_ORIGINS=
