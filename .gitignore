# dependencies
node_modules/

# build output
dist/
.turbo/

# logs
*.log

# env / secrets
.env
.env.*
!.env.example

# server-side sqlite store (sync v0)
server.db
server.db-*
# Pre-identity-refactor name. Kept because the old file still exists on any
# machine that ran the server before the rename — dropping the pattern
# un-ignores a live local database and invites committing it.
ghost-server.db
ghost-server.db-*

# os
.DS_Store

# claude code local settings
.claude/settings.local.json

# tauri / rust
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/schemas/

# bundled local-model assets (large; dropped in per SIDECAR.md, not committed)
apps/desktop/src-tauri/binaries/*
!apps/desktop/src-tauri/binaries/README.md
apps/desktop/src-tauri/models/*
!apps/desktop/src-tauri/models/README.md

# benchmark runs and generated training data (see docs/EVAL.md). Results are a
# local record of a specific machine and model; regenerate rather than commit.
bench/

# Local Python venv for lm-evaluation-harness (docs/EVAL.md). Not committed:
# it is a machine-local tool install, not part of the app.
.venv-lmeval/

# Machine-specific local Cargo linker override (see comment in the file)
apps/desktop/src-tauri/.cargo/config.toml

# Unsloth writes a compiled-kernel cache to its working directory; the "Launch
# Studio" button (apps/server/src/compute/studioLauncher.ts) starts it with the
# server's cwd, so this can land under the repo. It is a regenerated build
# artifact, never source.
unsloth_compiled_cache/
