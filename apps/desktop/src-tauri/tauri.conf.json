{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Penumbra",
  "version": "0.1.0",
  "identifier": "local.placeholder.assistant",
  "build": {
    "beforeDevCommand": "pnpm --filter @penumbra/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @penumbra/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Penumbra", "width": 1280, "height": 800 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["binaries/*", "models/*"]
  }
}
