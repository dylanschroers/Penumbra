# Copy this file to .env and fill in the values. .env is gitignored.
# apps/server/src/env.ts loads it into process.env at startup.

# The *local* compute target's bearer + base URL — the deployment default.
# Anything set through POST /compute/targets/local outranks these and persists,
# so a rotated key is a form in the UI rather than an edit here plus a restart;
# DELETE the same route to come back to these values. Chat, training, and
# benchmarking all resolve their Studio from that one place, so they can never
# end up on different ones. The key is minted by Studio and stored in
# ~/.unsloth/studio/auth/agent_api_key.json (the "minted" entry for the matching
# server URL). Studio answers /v1/models with 401 when the key is missing.
UNSLOTH_API_KEY=sk-unsloth-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
UNSLOTH_BASE_URL=http://127.0.0.1:8888

# Model id sent in Tier-1 chat requests. Studio serves whatever it has resident
# whatever this says, so it is a label rather than a choice; set it only when a
# backend actually routes on the id.
#UNSLOTH_MODEL=

# The command the compute panel's "Launch Studio" button runs to start the local
# Studio. Defaults to `unsloth studio`, which brings up the API server on
# 127.0.0.1:8888 with no model loaded (the panel's own picker then loads one).
# The button is loopback-only — it spawns a process on this machine, so it never
# appears to, nor works for, a client on another one. Set this to override the
# command, or to empty to turn the button off entirely.
#UNSLOTH_LAUNCH_CMD=unsloth studio

# The command the panel's "Stop Studio" button runs. Defaults to
# `unsloth studio stop`, which the CLI ships to shut a running server down. Same
# loopback-only rule as launch; set to empty to hide the Stop button.
#UNSLOTH_STOP_CMD=unsloth studio stop

# Gate for /agent/*, /lab/*, and /compute/*. Two ways in.
#
# Preferred: per-device tokens. Leave this unset and, from the server's own
# machine (loopback), add a device — `curl -X POST localhost:3000/auth/devices
# -H 'content-type: application/json' -d '{"label":"laptop"}'`, or the Devices
# section of the status pill. The token is shown once; paste it into that client's
# pill. Each device is revocable on its own.
#
# Or: one shared secret below. Any value you choose; every client sends the same
# one. Setting it means loopback must present it too. Unset and with no devices
# added, the routes serve loopback only, so an unconfigured server is never
# exposed to the network by accident.
#PENUMBRA_AGENT_TOKEN=

# Only when a reverse proxy (nginx, Caddy, a cloudflared/ngrok tunnel) sits in
# front. Without this the server reads the socket peer as the client, so behind a
# proxy every request looks like it came from 127.0.0.1 — and the auth gate's
# loopback exemption would open enrolment to anyone who can reach the proxy.
#
# Set it to the proxy's address or CIDR (e.g. 127.0.0.1 for a proxy on this host,
# or a subnet like 10.0.0.0/8), or to the number of proxy hops (e.g. 1). NOT a
# boolean — "true" would trust the forwarded header from any peer, letting a
# direct client spoof a loopback address, and is refused at startup.
#
# The proxy must SET X-Forwarded-For to the real client (nginx:
# `proxy_set_header X-Forwarded-For $remote_addr`), not pass a client-supplied
# one through — no server setting can undo a header the proxy forwards blindly.
#PENUMBRA_TRUST_PROXY=

# Where uploaded models and datasets land (models/ and datasets/ are created
# beneath it). Defaults to ~/.penumbra/uploads — point this at a drive with room
# for multi-GB models if your home drive is small.
#PENUMBRA_UPLOAD_DIR=

# HTTP port. Defaults to 3000.
#PORT=3000

# Where the SQLite file lives. Defaults to server.db in the working directory.
#DB_PATH=

# The lm_eval executable, for benchmarking. Defaults to `lm_eval` on PATH; set
# it to the binary inside a venv when it is not installed globally.
#LM_EVAL_BIN=

# How long a benchmark's lm_eval child may print nothing at all before it is
# treated as wedged and killed. Defaults to 300000 (five minutes).
#
# It exists because lm_eval can hang after the run itself has finished — seen on
# Windows at the summary-table step — which leaves the job at "running 100%"
# forever, holding the GPU and so timing out every chat turn aimed at the same
# host. Any output restarts the clock, so a healthy run is never touched: raise
# this only if a single request on your hardware can take longer than the budget.
#BENCHMARK_STALL_MS=300000

# Extra browser origins allowed to call this server, comma-separated. The app's
# own origins (the Tauri shell, and Vite on :5173) are built in; add to this only
# when the web build is served from somewhere else — a LAN address, a proxy, a
# different port. Anything not listed is refused, so a page the user merely
# visited cannot drive /agent/* or /lab/* through the loopback exemption above.
#PENUMBRA_ALLOWED_ORIGINS=http://192.168.1.50:5173
