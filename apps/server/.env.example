# Copy this file to .env and fill in the values. .env is gitignored.
# apps/server/src/env.ts loads it into process.env at startup.

# The *local* compute target's bearer + base URL — the deployment default.
# Anything set through POST /compute/targets/local outranks these and persists,
# so a rotated key is a form in the UI rather than an edit here plus a restart;
# DELETE the same route to come back to these values. Chat, training, and
# benchmarking all resolve their Studio from that one place, so they can never
# end up on different ones. The key is minted by Studio and stored in
# ~/.unsloth/studio/auth/agent_api_key.json (the "minted" entry for the matching
# server URL). Studio answers /v1/models with 401 when the key is missing.
UNSLOTH_API_KEY=sk-unsloth-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
UNSLOTH_BASE_URL=http://127.0.0.1:8888

# Gate for /agent/*, /lab/*, and /compute/*. Two ways in.
#
# Preferred: per-device tokens. Leave this unset and, from the server's own
# machine (loopback), add a device — `curl -X POST localhost:3000/auth/devices
# -H 'content-type: application/json' -d '{"label":"laptop"}'`, or the Devices
# section of the status pill. The token is shown once; paste it into that client's
# pill. Each device is revocable on its own.
#
# Or: one shared secret below. Any value you choose; every client sends the same
# one. Setting it means loopback must present it too. Unset and with no devices
# added, the routes serve loopback only, so an unconfigured server is never
# exposed to the network by accident.
#PENUMBRA_AGENT_TOKEN=

# Where uploaded models and datasets land (models/ and datasets/ are created
# beneath it). Defaults to ~/.penumbra/uploads — point this at a drive with room
# for multi-GB models if your home drive is small.
#PENUMBRA_UPLOAD_DIR=

# HTTP port. Defaults to 3000.
#PORT=3000

# Extra browser origins allowed to call this server, comma-separated. The app's
# own origins (the Tauri shell, and Vite on :5173) are built in; add to this only
# when the web build is served from somewhere else — a LAN address, a proxy, a
# different port. Anything not listed is refused, so a page the user merely
# visited cannot drive /agent/* or /lab/* through the loopback exemption above.
#PENUMBRA_ALLOWED_ORIGINS=http://192.168.1.50:5173
